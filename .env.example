# Wallet address that receives x402 payments (USDC on Base mainnet)
PAY_TO_WALLET=

# Coinbase CDP API credentials — REQUIRED.
# Generate at https://portal.cdp.coinbase.com
# Used by HTTPFacilitatorClient to verify and settle x402 payments.
# Without these, the server exits at boot with a clear fatal log.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Deployer private key on Fuse mainnet (chain 122) — REQUIRED for loyalty
# create + mint endpoints. The address derived from this key:
#   - pays gas for LoyaltyToken contract deployment and mint() calls
#   - is seeded as an initial minter on every token deployed via
#     /loyalty/create (so /loyalty/mint works out of the box)
# It is NOT the on-chain owner — the caller-supplied `owner` address from
# the /loyalty/create request body holds the only admin role and can
# revoke the deployer's minter privilege at any time via
# setMinter(deployerAddress, false).
# Fund this wallet with FUSE for gas at https://app.fuse.io
DEPLOYER_PRIVATE_KEY=

# Port the express server listens on (default 3000)
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# MPP (Machine Payments Protocol) — runs alongside x402.
# When MPP_ENABLED=true, the same paid endpoints also accept Tempo USDC,
# Stripe (Visa/Mastercard/wallets), and Bitcoin Lightning via MPP.
# ─────────────────────────────────────────────────────────────────────────────

# Toggle MPP middleware. Set "false" to fall back to x402-only behavior.
MPP_ENABLED=true

# HMAC key that cryptographically binds MPP challenge IDs to their contents.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Treat as root-of-trust material — never log, never commit, rotate if exposed.
MPP_SECRET_KEY=

# Tempo network recipient. Tempo is MPP's native settlement chain
# (sub-second finality, sub-cent fees). Chain IDs are auto-selected from
# TEMPO_TESTNET — 4217 for mainnet, 42431 for "Moderato" testnet.
#   - testnet (Moderato): faucet at https://docs.tempo.xyz/quickstart/faucet
#   - mainnet: bridge USDC from Ethereum/Base/Arbitrum/etc. via
#     https://relay.link/bridge (chain 4217)
TEMPO_TESTNET=true
TEMPO_PAY_TO=

# TEMPO_CURRENCY is OPTIONAL — when unset, defaults to pathUSD on testnet
# (0x20c0000000000000000000000000000000000000) and USDC.e on mainnet
# (0x20C000000000000000000000b9537d11c60E8b50). Override only when accepting
# AlphaUSD / BetaUSD / ThetaUSD or a non-default stablecoin.
# TEMPO_CURRENCY=

# Stripe — requires a Stripe account with "machine payments" enabled.
# - STRIPE_SECRET_KEY: sk_test_… in dev, sk_live_… in prod.
# - STRIPE_NETWORK_ID: Business Network profile ID from the Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_NETWORK_ID=

# Bitcoin Lightning via Spark. BTC_NETWORK is one of:
#   - "signet"  (public Bitcoin testnet — fund via the Spark signet faucet,
#                test sats with no real value; use this for previews/CI)
#   - "regtest" (local-only — you run bitcoind + Spark regtest, mine your
#                own blocks; overkill unless you need offline dev)
#   - "mainnet" (REAL BTC — server mnemonic owns real money; treat with the
#                same care as DEPLOYER_PRIVATE_KEY)
# The mnemonic seeds a server-side Spark wallet that receives Lightning
# payments. Anyone holding the mnemonic can sweep the wallet, so store it
# in a secrets manager and rotate immediately if exposed.
BTC_NETWORK=signet
BTC_MNEMONIC=

# Approximate BTC/USD FX rate used to convert per-route USD prices into
# satoshi amounts for Lightning charge challenges. Override when the rate
# drifts materially. Optional; defaults to 100000.
BTC_USD_RATE=100000
